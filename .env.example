# Machine-specific settings. Copy to `.env` (which is git-ignored) and edit.
# Every value is optional - the defaults work for a standard Windows install.
# %VARIABLES% are expanded.

# Folder that contains dirt2_game.exe. Only needed for the reverse-engineering
# tools in tools/ (the converter itself finds the running game by process name).
# DIRT2_GAME_DIR=C:\Games\DiRT 2

# The PC "savegame" folder. Default: <Documents>\My Games\DiRT2\savegame
# DIRT2_SAVEGAME_DIR=%USERPROFILE%\Documents\My Games\DiRT2\savegame

# Save slot folder name inside savegame. Default: Autosave0
# DIRT2_SLOT=Autosave0

# The Xbox 360 save package. Default: auto-detected on any drive under
# [Xbox360\]Content\<profile id>\434D0819\00000001\
# DIRT2_X360_SAVE=E:\Content\E0000XXXXXXXXXXX\434D0819\00000001\XXXXXXXX

# Where backups and logs are written. Default: .\work inside the repository
# DIRT2_WORK_DIR=

# Comma separated Xbox 360 title ids to look for (other regions may differ)
# DIRT2_X360_TITLE_IDS=434D0819

# A PC save used as reference by the analysis tools. Default: the live slot
# DIRT2_PC_REF_SAVE=
